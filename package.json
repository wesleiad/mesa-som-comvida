{
  "name": "mesadesom-comvida",
  "version": "1.0.0",
  "description": "Mesa de Som - Com.Vida: controle fácil das mesas Soundcraft Ui (Ui12/Ui16/Ui24R) pelo computador, tablet ou celular",
  "main": "./out/main/index.js",
  "author": "Comunidade Vida",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:win": "electron-vite build && electron-builder --win",
    "test:ui": "npm run build && node scripts/verify-ui.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@fontsource/fredoka": "5.2.8",
    "electron-updater": "6.3.9",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "soundcraft-ui-connection": "7.0.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "rxjs": "7.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wesleiad/mesa-som-comvida.git"
  },
  "homepage": "https://github.com/wesleiad/mesa-som-comvida"
}
